<Page x:Class="Курсова_робота.AdminLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Курсова_робота"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminLogin"
      Style="{StaticResource FadeInPageStyle}">
    <!-- Стиль анімації сторінки -->
    <Grid>
        <!-- Кнопка виходу -->
        <Button Content="Вихід" 
                Click="LogoutButton_Click"
                Width="100" 
                Height="35"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="20"
                Background="White"
                BorderBrush="Transparent"
                FontFamily="Courier New"
                Style="{StaticResource StaticRoundedButtonStyle}">
                <!-- Стиль кнопки без анімації -->
        </Button>
        <!-- Центральна панель -->
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
            <!-- Заголовок -->
            <TextBlock Text="Вхід"
                        FontFamily="Courier New"
                        FontWeight="Bold"
                        FontSize="32"
                        Foreground="#FF69B4"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,30"/>
            <!-- Блоки введення ім'я та паролю -->
            <TextBlock Text="Ваше ім'я:"
                       FontFamily="Courier New"
                       FontSize="15"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>
            <Border CornerRadius="15"
                    BorderBrush="#FF69B4"
                    BorderThickness="1.5"
                    Height="35"
                    Margin="0,0,0,20"
                    Background="White">
                <TextBox x:Name="NameBox" 
                     Foreground="Black"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalAlignment="Center"
                     Margin="10,0,10,0"/>
            </Border>
            <TextBlock Text="Пароль:"
                       FontFamily="Courier New"
                       FontSize="15"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>
            <Border CornerRadius="15"
                    BorderBrush="#FF69B4"
                    BorderThickness="1.5"
                    Height="35"
                    Margin="0,0,0,30"
                    Background="White">
                <PasswordBox x:Name="PasswordBox"
                         Foreground="#FF69B4"
                         PasswordChar="♥"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalAlignment="Center"
                         Margin="10,0,10,0"/>
            </Border>
            <!-- Кнопка входу -->
            <Button x:Name="ExitButton"
                    Content="Увійти"
                    Foreground="White"
                    FontSize="15"
                    Background="#FF69B4"
                    FontFamily="Courier New"
                    FontWeight="Bold"
                    Width="150"
                    Height="40"
                    BorderBrush="Transparent"
                    HorizontalAlignment="Center" 
                    Click="ExitButton_Click"
                    RenderTransformOrigin="0.5,0.5"
                    Style="{StaticResource AnimationOnlyStyle}">
                    <!-- Стиль кнопки з анімацією -->
            </Button>
        </StackPanel>
    </Grid>
</Page>
