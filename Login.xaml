<Page x:Class="Курсова_робота.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Курсова_робота"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Login"
      
      Style="{StaticResource FadeInPageStyle}">
    <Grid>
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
            <TextBlock Text="Вхід у систему"
                       FontFamily="Courier New"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FF69B4"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>
            <TextBlock Text="Оберіть вашу роль:"
                       FontFamily="Courier New"
                       FontSize="18"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>
            <Button x:Name="AdminButton" 
                    Content="Я отримувач"
                    FontSize="20"
                    FontFamily="Courier New"
                    Width="250"
                    Height="50"
                    Background="White"
                    Margin="0,10"
                    BorderBrush="#FF69B4"
                    BorderThickness="2"
                    Click="AdminButton_Click"
                    Style="{StaticResource AnimationOnlyStyle}"
                    RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1"
                                    ScaleY="1"/>
                </Button.RenderTransform>
            </Button>
            <Button x:Name="UserButton" 
                    Content="Я дарувальник"
                    FontFamily="Courier New"
                    Foreground="White"
                    FontSize="20"
                    Width="250"
                    Height="50"
                    Background="#FF69B4"
                    Margin="0,10"
                    BorderBrush="Transparent"
                    Click="UserButton_Click"
                    Style="{StaticResource AnimationOnlyStyle}"
                    RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1"
                                    ScaleY="1"/>
                </Button.RenderTransform>
            </Button>
        </StackPanel>
    </Grid>
</Page>
