<Page x:Class="Курсова_робота.AddGiftP"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Курсова_робота"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddGiftP"
      Style="{StaticResource FadeInPageStyle}">
    <!-- Стиль анімації сторінки -->
    <Grid Margin="30">
        <!-- Розмітка рядків(Заголовок, кнопки)-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Заголовок сторінки -->
        <TextBlock Grid.Row="0" 
               Text="Додати подарунок" 
               FontFamily="Courier New" 
               FontSize="30" 
               FontWeight="Bold" 
               Foreground="#FF69B4" 
               HorizontalAlignment="Center" 
               Margin="0,0,0,20"/>
        <!-- Основна форма(два стовпці фото та поля вводу)-->
        <Grid Grid.Row="1" VerticalAlignment="Center" MaxWidth="800">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Ствопець фото -->
            <StackPanel Grid.Column="0" 
                        Margin="10" 
                        VerticalAlignment="Top">
                <Border x:Name="ImageBorder" 
                        MinHeight="150" 
                        MaxHeight="300" 
                        BorderBrush="#FF69B4" 
                        BorderThickness="2" 
                        CornerRadius="15" 
                        Background="White">
                    <Image x:Name="GiftImagePreview" 
                           Stretch="UniformToFill" 
                           Margin="5"/>
                </Border>
                <Button x:Name="UploadImageButton" 
                        Content="Вибрати фото" 
                        Margin="0,10,0,0" 
                        Height="35" 
                        Background="White" 
                        FontFamily="Courier New" 
                        FontSize="15"
                        BorderBrush="Transparent"
                        Click="UploadImageButton_Click"
                        
                        Style="{StaticResource StaticRoundedButtonStyle}">
                </Button>
            </StackPanel>
            <!-- Стовпець поля вводу -->
            <StackPanel Grid.Column="1" 
                        Margin="20,0,10,0">
                <TextBlock Text="Назва:"
                           FontFamily="Courier New"
                           FontSize="12"
                           Foreground="Gray"
                           FontWeight="Bold"
                           Margin="0,5"/>
                <TextBox x:Name="NameInput" 
                         Height="35" 
                         Margin="0,0,0,15"
                         BorderBrush="#FF69B4"
                         BorderThickness="1"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" 
                                Margin="0,0,5,0">
                        <TextBlock Text="Ціна:"
                                   FontFamily="Courier New"
                                   FontSize="12"
                                   Foreground="Gray"
                                   FontWeight="Bold"/>
                        <TextBox x:Name="PriceInput"
                                 BorderBrush="#FF69B4"
                                 BorderThickness="1"
                                 Height="35"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" 
                                Margin="5,0,0,0">
                        <TextBlock Text="Категорія:"
                                   FontFamily="Courier New"
                                   FontSize="12"
                                   Foreground="Gray"
                                   FontWeight="Bold"/>
                        <TextBox x:Name="CategoryInput" 
                                 BorderBrush="#FF69B4"
                                 BorderThickness="1"
                                 Height="35"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Посилання на товар (URL):"
                           FontFamily="Courier New"
                           FontSize="12"
                           Foreground="Gray"
                           FontWeight="Bold"
                           Margin="0,15,0,5"/>
                <TextBox x:Name="UrlInput"
                         BorderBrush="#FF69B4"
                         BorderThickness="1"
                         Height="35"/>
                <StackPanel Orientation="Horizontal" 
                            Margin="0,20,0,5">
                    <!-- Налаштування спільного подарунку-->
                    <CheckBox x:Name="SharedCheckBox"
                          Content="Спільний подарунок"
                          FontFamily="Courier New"
                          FontSize="15"
                          Foreground="Gray"
                          FontWeight="Bold"
                          VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" 
                            Margin="0,5,0,0">
                    <TextBlock Text="Кількість людей: "
                           Foreground="Gray"
                           FontFamily="Courier New"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                    <TextBox x:Name="MaxPeopleTextBox"
                         Foreground="Black"
                         Background="White"
                         Width="77"
                         Height="18"
                         VerticalContentAlignment="Center"
                         IsEnabled="{Binding ElementName=SharedCheckBox, Path=IsChecked}" RenderTransformOrigin="0.492,0.966"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <!-- Нижня панель кнопок -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,10,0,0">
            <Button Content="Скасувати"
                    FontFamily="Courier New"
                    FontSize="15"
                    Background="White"
                    BorderBrush="Transparent"
                    Width="120" 
                    Height="45" 
                    Margin="10" 
                    Click="Cancel_Click"
                    Style="{StaticResource StaticRoundedButtonStyle}">
                <!-- Стиль для кнопок без анімації -->
            </Button>
            <Button x:Name="SaveGiftButton" 
                    Content="Додати у список"
                    FontFamily="Courier New"
                    FontSize="15"
                    FontWeight="Bold"
                    Background="#FF69B4" 
                    Foreground="White"
                    BorderBrush="Transparent"
                    Width="200" 
                    Height="45" 
                    Margin="10"
                    Click="SaveGiftButton_Click"
                    Style="{StaticResource AnimationOnlyStyle}">
                <!-- Стиль для кнопок з анімацією -->
            </Button>
        </StackPanel>
    </Grid>
</Page>